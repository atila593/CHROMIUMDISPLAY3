#!/usr/bin/with-contenv bashio
set -e

bashio::log.info "Vérification de la compatibilité matérielle..."

# Vérification du GPU
if [ ! -d /dev/dri ]; then
    bashio::log.error "Aucune carte graphique détectée dans /dev/dri. Vérifiez les privilèges de l'add-on."
else
    bashio::log.info "Carte graphique trouvée avec succès."
fi

# Vérification des périphériques d'entrée
if [ ! -d /dev/input ]; then
    bashio::log.warning "Aucun périphérique d'entrée trouvé dans /dev/input. Le tactile pourrait ne pas fonctionner."
else
    INPUT_DEVICE_FOUND=false
    for input_device in /dev/input/event*; do
        if [ -e "$input_device" ]; then
            bashio::log.info "Périphérique d'entrée disponible : $input_device"
            INPUT_DEVICE_FOUND=true
        fi
    done

    if [ "$INPUT_DEVICE_FOUND" = false ]; then
        bashio::log.warning "Aucun périphérique event* trouvé dans /dev/input. Le tactile pourrait ne pas fonctionner."
    fi
fi

# Initialisation propre des permissions pour seatd
mkdir -p /run/user/0
chmod 700 /run/user/0
