#!/usr/bin/with-contenv bashio
set -e

LOG_PREFIX="[KIOSK-INIT]"
echo "$LOG_PREFIX Démarrage de la séquence d'initialisation du Kiosk..."

# 1. Configuration des variables d'environnement
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0777 "$XDG_RUNTIME_DIR"

export SEATD_SOCK=/run/seatd.sock
rm -f "$SEATD_SOCK"

# 2. Nettoyage préventif
pkill seatd || true
pkill udevd || true
sleep 1

# 3. Démarrage du démon Udev pour que libinput détecte les périphériques
echo "$LOG_PREFIX Démarrage du service udev..."
udevd --daemon || true
udevadm trigger --type=subsystems --action=add || true
udevadm trigger --type=devices --action=add || true
udevadm settle --timeout=3 || true

# 4. Démarrage de seatd
echo "$LOG_PREFIX Lancement du service seatd..."
seatd &
SEATD_PID=$!

TIMEOUT=5
while [ ! -S "$SEATD_SOCK" ] && [ $TIMEOUT -gt 0 ]; do
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done

if [ -S "$SEATD_SOCK" ]; then
    echo "$LOG_PREFIX [SUCCÈS] Service seatd opérationnel sur $SEATD_SOCK"
else
    echo "$LOG_PREFIX [ERREUR CRITIQUE] Échec seatd"
    exit 1
fi

export LIBSEAT_BACKEND=seatd

# 5. Paramètres de configuration wlroots / libinput
export WLR_BACKENDS=libinput,drm
export WLR_LIBINPUT_NO_DEVICES=0
export WLR_DRM_NO_ATOMIC=1
export WLR_NO_HARDWARE_CURSORS=1
export WLR_LOG_LEVEL=debug

# 6. Récupération de l'URL et lancement de Cage avec Chromium
TARGET_URL=$(bashio::config 'url' || echo "http://homeassistant:8123/lovelace/0")
echo "$LOG_PREFIX Lancement de l'affichage sur l'URL : $TARGET_URL"

ls -la /dev/dri/

echo "$LOG_PREFIX --- Test evtest (5s, touche l'écran maintenant) ---"
timeout 5 evtest /dev/input/event7 2>&1 | tee -a /tmp/touchtest.log || true
echo "$LOG_PREFIX --- Fin test evtest ---"

echo "$LOG_PREFIX Lancement de Cage avec capture des logs libinput..."

# Lancement de Cage et Chromium
cage -s -- chromium-browser \
  --kiosk \
  --no-first-run \
  --no-sandbox \
  --disable-dbus \
  --ozone-platform=wayland \
  --touch-events=enabled \
  --use-angle=gles \
  --disable-features=Vulkan \
  --enable-features=VaapiVideoDecoder,CanvasOopRasterization \
  --disable-dev-shm-usage \
  --disable-extensions \
  "http://homeassistant:8123/lovelace/0" > /tmp/cage_debug.log 2>&1 &

# Conserver le script actif pour que le service s6 ne stoppe pas le conteneur
CHILD_PID=$!
wait "$CHILD_PID"
