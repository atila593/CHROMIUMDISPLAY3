#!/bin/bash

LOG_PREFIX="[KIOSK-INIT]"
echo "$LOG_PREFIX Démarrage de la séquence d'initialisation du Kiosk..."

# 1. Configuration des variables d'environnement pour l'affichage et les inputs
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0777 "$XDG_RUNTIME_DIR"

export SEATD_SOCK=/run/seatd/seatd.sock
rm -f "$SEATD_SOCK"

# 2. Démarrage de seatd en arrière-plan avec des logs verbeux
echo "$LOG_PREFIX Lancement du service seatd..."
seatd -v -s "$SEATD_SOCK" &
SEATD_PID=$!

# Attente active que le socket seatd soit prêt (max 5 secondes)
TIMEOUT=5
while [ ! -S "$SEATD_SOCK" ] && [ $TIMEOUT -gt 0 ]; do
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done

if [ -S "$SEATD_SOCK" ]; then
    echo "$LOG_PREFIX [SUCCÈS] Service seatd opérationnel et en écoute sur $SEATD_SOCK (PID: $SEATD_PID)"
else
    echo "$LOG_PREFIX [ERREUR CRITIQUE] Échec du démarrage de seatd dans les délais impartis."
    exit 1
}

# 3. Export de la variable libseat pour forcer l'utilisation de seatd
export LIBSEAT_BACKEND=seatd

# 4. Listing complet et détaillé des périphériques d'entrée (Inputs)
echo "=================================================="
echo "$LOG_PREFIX LISTING DES PERIPHERIQUES D'ENTREE DETECTES :"
echo "=================================================="
ls -la /dev/input/
echo "--------------------------------------------------"

# Analyse détaillée de chaque event pour débusquer le tactile
TOUCH_DETECTED=0
for dev in /dev/input/event*; do
    if [ -e "$dev" ]; then
        # Utilisation de evtest ou lecture des infos sysfs si disponible, sinon description basique
        DEV_NAME=$(cat /sys/class/input/$(basename $dev)/device/name 2>/dev/null || echo "Inconnu")
        echo "$LOG_PREFIX Analyse de $dev -> Nom: $DEV_NAME"
        
        # Vérification si le périphérique correspond à un écran tactile / multitouch
        if echo "$DEV_NAME" | grep -Eiq "touch|pen|stylus|ft5x|goodix|egalax|atmel"; then
            echo "$LOG_PREFIX   >>> [TACTILE CONFIRMÉ] Périphérique tactile identifié sur $dev ($DEV_NAME)"
            TOUCH_DETECTED=1
        fi
    fi
done

if [ $TOUCH_DETECTED -eq 1 ]; then
    echo "$LOG_PREFIX [BILAN TACTILE] Au moins un contrôleur tactile est fonctionnel et prêt."
else
    echo "$LOG_PREFIX [BILAN TACTILE] Aucun profil tactile explicite détecté par nom (fonctionnement standard/générique libinput actif)."
fi
echo "=================================================="

# 5. Paramètres de configuration wlroots / libinput
export WLR_BACKENDS=libinput,drm
export WLR_LIBINPUT_NO_DEVICES=0
export WLR_DRM_NO_ATOMIC=1
export WLR_NO_HARDWARE_CURSORS=1
export WLR_LOG_LEVEL=debug

# 6. Lancement de l'URL cible (ajustez selon votre configuration Home Assistant)
TARGET_URL="${HOMEASSISTANT_URL:-http://homeassistant:8123/lovelace/0}"
echo "$LOG_PREFIX Lancement de l'affichage Kiosk sur l'URL : $TARGET_URL"

# 7. Exécution finale de Cage (compositeur Wayland) hébergeant Chromium
exec cage -s -- chromium-browser \
    --no-sandbox \
    --disable-infobars \
    --kiosk \
    --enable-features=OverlayScrollbar \
    --ozone-platform=wayland \
    "$TARGET_URL"
