#!/usr/bin/with-contenv bashio
set -e

LOG_PREFIX="[KIOSK-INIT]"
echo "$LOG_PREFIX Démarrage de la séquence d'initialisation du Kiosk..."

# 1. Configuration des variables d'environnement
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p "$XDG_RUNTIME_DIR"
chmod 07e7 "$XDG_RUNTIME_DIR" 2>/dev/null || chmod 0777 "$XDG_RUNTIME_DIR"

export SEATD_SOCK=/run/seatd.sock
rm -f "$SEATD_SOCK"

# 2. Nettoyage préventif
pkill seatd || true
sleep 1

# 3. Démarrage de seatd avec les droits appropriés si possible
echo "$LOG_PREFIX Lancement du service seatd..."
seatd -g root &
SEATD_PID=$!

TIMEOUT=5
while [ ! -S "$SEATD_SOCK" ] && [ $TIMEOUT -gt 0 ]; do
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done

if [ -S "$SEATD_SOCK" ]; then
    echo "$LOG_PREFIX [SUCCÈS] Service seatd opérationnel sur $SEATD_SOCK"
else
    echo "$LOG_PREFIX [ERREUR CRITIQUE] Échec seatd"
    exit 1
fi

export LIBSEAT_BACKEND=seatd

# 4. Paramètres de configuration wlroots / libinput
export WLR_BACKENDS=libinput,drm
export WLR_LIBINPUT_NO_DEVICES=0
export WLR_DRM_NO_ATOMIC=1
export WLR_NO_HARDWARE_CURSORS=1

# 5. Récupération de l'URL et lancement de Cage avec Chromium
TARGET_URL=$(bashio::config 'url' || echo "http://homeassistant:8123/lovelace/0")
echo "$LOG_PREFIX Lancement de l'affichage sur l'URL : $TARGET_URL"

if [ -d /dev/dri ]; then
    ls -la /dev/dri/
fi

if [ -d /dev/input ]; then
    echo "$LOG_PREFIX Périphériques d'entrée disponibles :"
    ls -la /dev/input/
fi

TOUCH_EVENT=
if [ -r /proc/bus/input/devices ]; then
    echo "$LOG_PREFIX Inventaire des périphériques d'entrée du noyau :"
    cat /proc/bus/input/devices
    TOUCH_EVENT=$(awk '
        BEGIN { RS = "" }
        {
            direct = 0
            handlers = ""
            count = split($0, lines, "\n")
            for (i = 1; i <= count; i++) {
                if (lines[i] == "B: PROP=2") {
                    direct = 1
                } else if (index(lines[i], "H: Handlers=") == 1) {
                    handlers = substr(lines[i], 13)
                }
            }
            if (direct) {
                count = split(handlers, names, " ")
                for (i = 1; i <= count; i++) {
                    if (names[i] ~ /^event[0-9]+$/) {
                        print "/dev/input/" names[i]
                        exit
                    }
                }
            }
        }
    ' /proc/bus/input/devices)
else
    echo "$LOG_PREFIX Inventaire des périphériques d'entrée du noyau indisponible."
fi

echo "$LOG_PREFIX Lancement de Cage..."

# Afficher les diagnostics dans les logs de l'add-on et les conserver dans un fichier
cage -- env WAYLAND_DEBUG=1 chromium-browser \
  --kiosk \
  --no-first-run \
  --no-sandbox \
  --disable-dbus \
  --ozone-platform=wayland \
  --touch-events=enabled \
  --use-angle=gles \
  --disable-features=Vulkan \
  --enable-features=VaapiVideoDecoder,CanvasOopRasterization \
  --disable-dev-shm-usage \
  --disable-extensions \
  "$TARGET_URL" > >(awk '
      /wl_seat@.*capabilities/ || /wl_touch@/ {
          print
          fflush()
          next
      }
      !/ wl_[[:alnum:]_]+@[0-9]+/ {
          print
          fflush()
      }
  ' | tee /tmp/cage_debug.log) 2>&1 &

CHILD_PID=$!
TOUCH_TEST_PID=

trap 'kill -TERM "$CHILD_PID" "$SEATD_PID" 2>/dev/null || true
    if [ -n "$TOUCH_TEST_PID" ]; then
        kill -TERM "$TOUCH_TEST_PID" 2>/dev/null || true
    fi
    exit 0' TERM INT

if [ -n "$TOUCH_EVENT" ]; then
    echo "$LOG_PREFIX Test des événements tactiles sur $TOUCH_EVENT pendant 30 secondes. Touchez l'écran maintenant."
    timeout 30 evtest "$TOUCH_EVENT" > >(tee -a /tmp/cage_debug.log) 2>&1 &
    TOUCH_TEST_PID=$!
else
    echo "$LOG_PREFIX Aucun périphérique tactile direct détecté dans /proc/bus/input/devices."
fi

# Attente de la fin du processus principal pour maintenir le service actif
wait "$CHILD_PID"
