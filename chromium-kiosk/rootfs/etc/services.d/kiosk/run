#!/usr/bin/with-contenv bashio
set -e

bashio::log.info "Démarrage du Kiosk en Mode Direct..."

export XDG_RUNTIME_DIR=/run/user/0
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0777 "$XDG_RUNTIME_DIR"

unset LIBSEAT_BACKEND
unset SEATD_SOCK
export WLR_BACKENDS=libinput,drm
export WLR_LIBINPUT_NO_DEVICES=0
export WLR_DRM_NO_ATOMIC=1
export WLR_NO_HARDWARE_CURSORS=1
export WLR_LOG_LEVEL=debug

bashio::log.info "Vérification des périphériques input :"
ls -la /dev/input/ || true

URL=$(bashio::config 'url')
bashio::log.info "Lancement de l'affichage sur l'URL : $URL"

exec cage -d -s -- chromium-browser \
    --ozone-platform=wayland \
    --ozone-platform-hint=wayland \
    --enable-features=UseOzonePlatform,WaylandWindowDecorations \
    --touch-events=enabled \
    --enable-pinch \
    --kiosk \
    --no-sandbox \
    --disable-gpu-sandbox \
    --autoplay-policy=no-user-gesture-required \
    --disable-features=WebRtcAllowInputVolumeAdjustment \
    "$URL"
