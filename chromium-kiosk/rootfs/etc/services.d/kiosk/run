#!/usr/bin/with-contenv bashio
set -e

bashio::log.info "Préparation de l'environnement graphique Kiosk..."

# 1. Configuration des chemins et variables d'environnement
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0777 "$XDG_RUNTIME_DIR"  # On passe en 777 pour s'assurer que Chromium et Cage y écrivent sans blocage

# 2. Attente active de la création du socket par le service seatd
timeout=0
while [ ! -S /run/seatd.sock ]; do
    if [ "$timeout" -ge 10 ]; then
        bashio::log.error "Le socket seatd n'a pas été trouvé après 10 secondes."
        exit 1
    fi
    sleep 0.5
    timeout=$((timeout + 1))
done

# 3. Forcer la connexion vers le daemon seatd
export LIBSEAT_BACKEND=seatd
export SEATD_SOCK=/run/seatd.sock
export WLR_DRM_NO_ATOMIC=1
export WLR_NO_HARDWARE_CURSORS=1
export ALL_PROXY=
export XDG_SESSION_TYPE=wayland
export WLR_LIBINPUT_NO_DEVICES=0
export WLR_LOG_LEVEL=debug

# 4. Lancement de l'affichage (en s'assurant d'exécuter avec les droits du groupe input)
URL=$(bashio::config 'url')
bashio::log.info "Lancement du kiosque sur l'URL : $URL"

# On utilise sg ou s6-setuidgid si nécessaire pour s'assurer que Cage hérite du groupe input, 
# ou on lance directement si le conteneur tourne déjà en root (le groupe root incluant input).
exec cage -d -s -- chromium-browser \
    --ozone-platform=wayland \
    --ozone-platform-hint=wayland \
    --enable-features=UseOzonePlatform,WaylandWindowDecorations \
    --touch-events=enabled \
    --kiosk \
    --no-sandbox \
    --disable-gpu-sandbox \
    --autoplay-policy=no-user-gesture-required \
    --disable-features=WebRtcAllowInputVolumeAdjustment \
    "$URL"
